# Copy this file to .env and adjust values as needed.
# .env is gitignored — .env.example is the committed reference.
NODE_ENV=development
PORT=3000
# Base URL used to build the `url` field in API responses.
# Must match the public address of the API.
APP_BASE_URL=http://localhost:3000
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=images_db
# Absolute path where uploaded image files are stored inside the container.
UPLOADS_DIR=/app/uploads
